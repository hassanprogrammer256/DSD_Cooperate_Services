# Copy to .env for local dev. Never commit the real .env file.

# Marks this file as the dev config — the check-dev-env pre-commit hook looks for
# this to catch a .env that's been swapped for prod values (e.g. copied off the
# EC2 box for debugging) and left that way by accident.
ENVIRONMENT=dev

DJANGO_SECRET_KEY=generate-with-get_random_secret_key
TAP_SECRET_KEY=
PUBLIC_SITE_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@dsdgrp.com
LEAD_NOTIFICATION_EMAIL=info@dsdgrp.com
LEAD_WEBHOOK_URL=
